# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_workplace"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth — obtain from Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Company domain allowlist — only emails ending with this domain can sign in
ALLOWED_EMAIL_DOMAIN="yourcompany.com"
