generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(VIEWER)
  accounts      Account[]
  sessions      Session[]
  pageLayouts   PageLayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

// Block Editor tables
model PortalPage {
  id        String     @id @default(cuid())
  slug      String     @unique
  pageType  String     @default("home") @map("page_type")
  title     String
  layouts   PageLayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("portal_pages")
}

model PageLayout {
  id          String            @id @default(cuid())
  pageId      String            @map("page_id")
  version     Int
  blocks      Json              // JSONB in PostgreSQL
  status      PageLayoutStatus  @default(DRAFT)
  publishedAt DateTime?         @map("published_at")
  createdById String?           @map("created_by")

  page        PortalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy   User?      @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, version])
  @@index([pageId, status])
  @@map("page_layouts")
}

enum PageLayoutStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
